# Copy to .env (git-ignored) and fill in. Demo and live are completely separate
# systems: separate credentials, separate API keys, separate data.

# IG API key for the environment set below (Settings > API keys on IG's site).
IG_API_KEY=

# IG account login (the username, not the account number).
IG_USERNAME=
IG_PASSWORD=

# Which IG environment to hit: "demo" or "live". Selects the base URL.
IG_ACCOUNT_TYPE=demo

# --- notebook config -------------------------------------------------------

# Market to pull candles for (default: IG "US Tech 100 Cash", the NASDAQ 100
# index CFD).
IG_EPIC=IX.D.NASDAQ.IFA.IP

# IG candle resolution, e.g. DAY, MINUTE_10. Used by all four notebooks.
IG_RESOLUTION=DAY

# 01_download_prices.ipynb: download window, UTC. IG_START is required -
# "YYYY-MM-DD" (00:00:00 that day) or "YYYY-MM-DDTHH:MM:SS". A stale value
# here silently re-downloads the same window and spends historical-data
# allowance, so check it before each run.
IG_START=2024-01-01

# IG_END: window end, UTC, same formats as IG_START (a bare date rolls to
# 23:59:59 that day). Leave blank for "now".
IG_END=

# Lookback window in calendar days. Parsed but currently unused - the download
# notebook takes an explicit IG_START/IG_END window instead.
IG_DAYS_BACK=1

# 01_download_prices.ipynb: write data/ig_<epic-slug>_<suffix>_<timestamp>.csv ("true"/"false").
IG_SAVE_CSV=true

# Parsed but currently unused - 01_download_prices.ipynb writes only the CSV;
# load it into data/ig_market_data.db with 02_import_csv_to_db.ipynb.
IG_SAVE_DB=false
